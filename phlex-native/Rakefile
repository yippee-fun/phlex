# frozen_string_literal: true

require "rake/extensiontask"
require "rubygems/package_task"

SPEC = Gem::Specification.load(File.expand_path("phlex-native.gemspec", __dir__))

PLATFORMS = %w[
	aarch64-linux-gnu
	aarch64-linux-musl
	arm64-darwin
	x64-mingw-ucrt
	x86_64-darwin
	x86_64-linux-gnu
	x86_64-linux-musl
].freeze

# The build containers set RUBY_CC_VERSION to every Ruby they can cross-compile
# for. Only the ones the gemspec supports are built.
if (versions = ENV["RUBY_CC_VERSION"])
	ENV["RUBY_CC_VERSION"] = versions.split(":").select { |version| SPEC.required_ruby_version.satisfied_by?(Gem::Version.new(version)) }.join(":")
end

Gem::PackageTask.new(SPEC).define

Rake::ExtensionTask.new("phlex_native", SPEC) do |ext|
	ext.lib_dir = "lib/phlex_native"
	ext.cross_compile = true
	ext.cross_platform = PLATFORMS

	ext.cross_compiling do |spec|
		newest = ENV.fetch("RUBY_CC_VERSION").split(":").map { |version| Gem::Version.new(version).segments.first(2) }.max
		spec.required_ruby_version = [*SPEC.required_ruby_version.as_list, "< #{newest[0]}.#{newest[1] + 1}.dev"]
	end
end

namespace :gem do
	# One at a time: the gnu and musl builds for an architecture share a tmp directory.
	desc "Build the precompiled gems for every platform in Docker"
	task native: PLATFORMS.map { |platform| "gem:native:#{platform}" }

	PLATFORMS.each do |platform|
		desc "Build the precompiled gem for #{platform} in Docker"
		task "native:#{platform}" do
			require "rake_compiler_dock"

			# The gemspec reads Phlex's version from the parent directory.
			RakeCompilerDock.sh(
				"rake native:#{platform} pkg/#{SPEC.full_name}-#{Gem::Platform.new(platform)}.gem",
				platform:,
				mountdir: File.expand_path("..", __dir__),
				workdir: __dir__,
			)
		end
	end
end

task default: :compile
